{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "device-telemetry-dashboard",
    "version": "1.0.0",
    "producedBy": "agent-a-ui",
    "consumedBy": ["agent-b-platform", "agent-c-app"]
  },
  "color": {
    "brand": {
      "primary": "#1F5FCC",
      "primaryHover": "#174CA3",
      "primaryContrast": "#FFFFFF"
    },
    "neutral": {
      "bg": "#F7F8FA",
      "surface": "#FFFFFF",
      "border": "#D9DEE5",
      "textPrimary": "#101828",
      "textSecondary": "#475467",
      "textDisabled": "#98A2B3"
    },
    "status": {
      "deviceOnline": "#12B76A",
      "deviceOffline": "#98A2B3",
      "deviceOfflineBg": "#F2F4F7"
    },
    "alertSeverity": {
      "info": "#2E90FA",
      "infoBg": "#EFF8FF",
      "warning": "#F79009",
      "warningBg": "#FFFAEB",
      "critical": "#F04438",
      "criticalBg": "#FEF3F2"
    },
    "feedback": {
      "success": "#12B76A",
      "successBg": "#ECFDF3",
      "error": "#F04438",
      "errorBg": "#FEF3F2",
      "warning": "#F79009",
      "warningBg": "#FFFAEB"
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(16, 24, 40, 0.05)",
    "md": "0 4px 8px rgba(16, 24, 40, 0.08)",
    "lg": "0 8px 24px rgba(16, 24, 40, 0.12)"
  },
  "typography": {
    "fontFamily": {
      "base": "'Inter', 'Segoe UI', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Consolas', monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px",
      "xxl": "32px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  },
  "chart": {
    "lineColor": "#1F5FCC",
    "gridColor": "#EAECF0",
    "windowHours": 24,
    "staleAfterSeconds": 30
  },
  "zIndex": {
    "shellNav": 100,
    "notificationDropdown": 200,
    "modal": 300,
    "toast": 400
  }
}
