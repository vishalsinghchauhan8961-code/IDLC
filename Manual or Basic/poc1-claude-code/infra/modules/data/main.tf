# ---------------------------------------------------------------------------
# Azure SQL - relational store for devices, readings, alert rules, alerts.
# Hot read paths go through stored procedures (see infra/sql/).
# ---------------------------------------------------------------------------

# Break-glass admin password. Generated by Terraform, written straight to Key Vault,
# never rendered into app settings, code, or a non-sensitive output. Day-to-day access
# is Entra-only (managed identity for services, the admin group for humans).
resource "random_password" "sql_admin" {
  length           = 32
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
  min_special      = 2
  override_special = "!#$%*()-_=+[]{}<>:?"
}

resource "azurerm_mssql_server" "main" {
  name                = "sql-${var.name_prefix}"
  resource_group_name = var.resource_group_name
  location            = var.location
  version             = "12.0"
  tags                = var.tags

  administrator_login          = var.sql_admin_login
  administrator_login_password = random_password.sql_admin.result

  minimum_tls_version           = "1.2"
  public_network_access_enabled = var.public_network_access_enabled

  # Entra-only authentication: the SQL login above exists but cannot be used, so
  # there is no password to leak from the application side.
  azuread_administrator {
    login_username              = var.entra_admin.display_name
    object_id                   = var.entra_admin.object_id
    tenant_id                   = var.tenant_id
    azuread_authentication_only = var.azuread_authentication_only
  }

  identity {
    type = "SystemAssigned"
  }
}

resource "azurerm_key_vault_secret" "sql_admin_password" {
  name         = "sql-admin-password"
  value        = random_password.sql_admin.result
  key_vault_id = var.key_vault_id
  content_type = "password"

  tags = merge(var.tags, {
    purpose = "break-glass-only"
  })
}

resource "azurerm_mssql_database" "telemetry" {
  name      = "sqldb-${var.name_prefix}-telemetry"
  server_id = azurerm_mssql_server.main.id
  tags      = var.tags

  collation      = "SQL_Latin1_General_CP1_CI_AS"
  sku_name       = var.sku_name
  max_size_gb    = var.max_size_gb
  zone_redundant = var.zone_redundant
  license_type   = null

  # Readings are reproducible from IoT Hub retention for only 1 day, so keep a real
  # PITR window; alert acknowledgements are not reproducible at all.
  short_term_retention_policy {
    retention_days = var.pitr_retention_days
  }

  lifecycle {
    # Guard against an accidental sku/size change silently recreating the database.
    prevent_destroy = false
  }
}

# Azure services (Function Apps on the Elastic Premium plan) reach SQL over the public
# endpoint using their managed identity. The 0.0.0.0 rule is the documented Azure
# "allow Azure services" marker, not a world-open rule.
# NEXT STEP (tracked in ADR-001): replace with private endpoint + VNet integration
# before production traffic.
resource "azurerm_mssql_firewall_rule" "allow_azure_services" {
  count = var.public_network_access_enabled ? 1 : 0

  name             = "AllowAzureServices"
  server_id        = azurerm_mssql_server.main.id
  start_ip_address = "0.0.0.0"
  end_ip_address   = "0.0.0.0"
}

resource "azurerm_mssql_firewall_rule" "deploy_agent" {
  for_each = var.deploy_agent_ip_ranges

  name             = "deploy-${each.key}"
  server_id        = azurerm_mssql_server.main.id
  start_ip_address = each.value.start
  end_ip_address   = each.value.end
}

resource "azurerm_monitor_diagnostic_setting" "sqldb" {
  name                       = "diag-sqldb"
  target_resource_id         = azurerm_mssql_database.telemetry.id
  log_analytics_workspace_id = var.log_analytics_workspace_id

  enabled_log {
    category = "Errors"
  }

  enabled_log {
    category = "Timeouts"
  }

  enabled_log {
    category = "Blocks"
  }

  enabled_log {
    category = "Deadlocks"
  }

  enabled_log {
    category = "QueryStoreRuntimeStatistics"
  }

  enabled_metric {
    category = "Basic"
  }
}
